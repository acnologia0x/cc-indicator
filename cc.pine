//@version=5
indicator("$cc", overlay=false)
ema50 = ta.ema(close, 50)
ema200 = ta.ema(close, 200)
atr1 = ta.atr(1)
atr14 = ta.atr(14)
plot(close, color=color.gray, title="Line Chart", force_overlay=true)
plot(ema50, color=color.blue, title="50 EMA", force_overlay=true)
plot(ema200, color=color.red, title="200 EMA", force_overlay=true)
plot(atr1, color=color.white, title="ATR(1)")
plot(atr14, color=color.yellow, title="ATR(14)")

// Timezone Setup
tz = input.string("America/New_York", "Timezone")

// Session 1 Setup
sess1 = input.session("1900-0300", "Session 1 Time")
name1 = input.string("Asia", "Session 1 Name")

// Session 2 Setup
sess2 = input.session("0300-1130", "Session 2 Time")
name2 = input.string("London", "Session 2 Name")

// Session 3 Setup
sess3 = input.session("0930-1600", "Session 3 Time")
name3 = input.string("New York", "Session 3 Name")

// Check if current bar is inside each session
in1 = not na(time(timeframe.period, sess1, tz))
in2 = not na(time(timeframe.period, sess2, tz))
in3 = not na(time(timeframe.period, sess3, tz))

// Detect when each session transitions to closed
closed1 = not in1 and in1[1]
closed2 = not in2 and in2[1]
closed3 = not in3 and in3[1]

// Store the name of the last closed session
var string lastClosed = "None yet"

if closed1
    lastClosed := name1
if closed2
    lastClosed := name2
if closed3
    lastClosed := name3

// Build a text string of all currently open sessions
string currentOpen = ""

if in1
    currentOpen := currentOpen == "" ? name1 : currentOpen + ", " + name1
if in2
    currentOpen := currentOpen == "" ? name2 : currentOpen + ", " + name2
if in3
    currentOpen := currentOpen == "" ? name3 : currentOpen + ", " + name3

if currentOpen == ""
    currentOpen := "None"

// Create the display table
var table infoTable = table.new(position.bottom_right, 2, 2, bgcolor=color.new(color.black, 80), border_color=color.gray, border_width=1)

// Update table on the live candle
if barstate.islast
    table.cell(infoTable, 0, 0, "Currently Open:", text_color=color.white)
    table.cell(infoTable, 1, 0, currentOpen, text_color=color.green)
    
    table.cell(infoTable, 0, 1, "Last Closed:", text_color=color.white)
    table.cell(infoTable, 1, 1, lastClosed, text_color=color.red)